// ----------------------------------------------------
// 1. НАЛАШТУВАННЯ КЛІЄНТІВ ДЛЯ GRAFANA CLOUD
// ----------------------------------------------------

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_LOKI_URL")
    basic_auth {
      username = sys.env("GC_LOKI_USER")
      password = sys.env("GC_API_KEY")
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GC_PROMETHEUS_USER")
      password = sys.env("GC_API_KEY")
    }
  }
}

// ----------------------------------------------------
// 2. ЗБІР ЛОГІВ З УСІХ DOCKER-КОНТЕЙНЕРІВ
// ----------------------------------------------------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

// ----------------------------------------------------
// 3. ЗБІР СИСТЕМНИХ МЕТРИК КОНТЕЙНЕРІВ (cadvisor)
// ----------------------------------------------------

prometheus.exporter.cadvisor "docker_metrics" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "cadvisor" {
  targets    = prometheus.exporter.cadvisor.docker_metrics.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}